#!/bin/sh

set -e

GPG_REALNAME=$1
GPG_EMAIL=$2

if [ -z "$GPG_REALNAME" -o -z "$GPG_EMAIL" ]; then
  echo "Usage: $0 GPG_REALNAME GPG_EMAIL"
  exit 1
fi

MOLIOR_USER=molior
HOME_DIR=/var/lib/molior

GPG_BINARY=gpg
export GPG_TTY=`tty`

# Only generate keys if there is no gpg home at all (gpg creates it itself, so this must be checked first).
# An existing .gnupg may hold keys with another e-mail, it must be left alone.
if [ ! -e "$HOME_DIR/.gnupg" ]; then
  echo 'Generating GPG keys ...'
  su - $MOLIOR_USER -c "$GPG_BINARY --no-tty --batch --gen-key" <<EOF
%no-protection
Key-Type: RSA
Key-Length: 2048
Key-Usage: encrypt, sign
Subkey-Type: RSA
Subkey-Length: 2048
Subkey-Usage: encrypt, sign
Name-Real: $GPG_REALNAME
Name-Comment: none
Name-Email: $GPG_EMAIL
Expire-Date: 0
%commit
EOF
else
  echo '.gnupg for molior already exists, not generating a gpg key'
fi

# create ssh key
if [ ! -e "$HOME_DIR/.ssh/id_rsa.pub" ]; then
 echo 'Generating SSH keys ...'
 su molior -c 'ssh-keygen -q -t rsa -N "" -f ~/.ssh/id_rsa'
else
 echo 'ssh key for molior already exists'
fi

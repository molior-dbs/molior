#!/bin/sh
# Ask for the passwords and store them in the Secret molior-passwords of the namespace.
# Runs on the dev machine and needs a terminal. Usage: make set-passwords
#
# It uses the current kubectl context (kubectl config current-context) and prints it.
#   NAMESPACE     namespace (required)
#
# Keys: molior-password (admin login and session signing secret), aptly-password (molior and
# aptly-nginx), registry-password (nothing reads it yet).
# An empty answer keeps the current password of that key. A password is asked twice.
# Nothing is written before all answers are in. The passwords are not shown, not in the process
# arguments and not in the output. The Secret is created if it does not exist, otherwise only the
# keys you entered are changed. The pods read the Secret at start, so restart them afterwards.
set -eu

NAMESPACE=${NAMESPACE:-}
SECRET=molior-passwords
KEYS="molior-password aptly-password registry-password"

[ -n "$NAMESPACE" ] || { echo "Usage: make set-passwords" >&2; exit 1; }
CONTEXT=$(kubectl config current-context) || { echo "Error: no current kubectl context" >&2; exit 1; }

k() { kubectl -n "$NAMESPACE" "$@"; }

if [ -t 0 ]; then
    stty -echo
    trap 'stty echo' EXIT INT TERM
fi

# ask <prompt>: the answer is in $REPLY
ask() {
    printf '%s' "$1" >&2
    IFS= read -r REPLY || REPLY=""
    if [ -t 0 ]; then printf '\n' >&2; fi
}

EXISTS=""
EXISTING=$(k get secret "$SECRET" -o go-template='{{range $k, $v := .data}}{{$k}} {{end}}' 2>/dev/null) && EXISTS=1 || true
if [ -n "$EXISTS" ]; then
    echo "Secret $SECRET in $NAMESPACE (context $CONTEXT) exists, keys: $EXISTING" >&2
else
    echo "Secret $SECRET in $NAMESPACE (context $CONTEXT) does not exist yet" >&2
fi

DATA=""
CHANGED=""
for key in $KEYS; do
    case " $EXISTING " in *" $key "*) state="set, empty keeps it" ;; *) state="not set" ;; esac
    ask "$key ($state): "
    pw=$REPLY
    [ -n "$pw" ] || continue
    ask "$key again: "
    [ "$REPLY" = "$pw" ] || { echo "Error: the two entries for $key differ, nothing was changed" >&2; exit 1; }
    DATA="${DATA:+$DATA,}\"$key\":\"$(printf '%s' "$pw" | base64 | tr -d '\n')\""
    CHANGED="$CHANGED $key"
done

if [ -z "$CHANGED" ]; then
    echo "No password entered, nothing changed." >&2
else
    if ! kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
        kubectl create namespace "$NAMESPACE"
    fi
    if [ -n "$EXISTS" ]; then
        printf '{"data":{%s}}' "$DATA" | k patch secret "$SECRET" --type merge --patch-file /dev/stdin
    else
        printf '{"apiVersion":"v1","kind":"Secret","metadata":{"name":"%s","namespace":"%s"},"type":"Opaque","data":{%s}}' \
            "$SECRET" "$NAMESPACE" "$DATA" | kubectl create -f -
    fi
    echo "Changed:$CHANGED" >&2
    echo "The pods read the Secret at start: restart them (helm uninstall and install, or delete the pods) to use it." >&2
    case "$CHANGED" in *molior-password*) echo "A new molior-password also ends all sessions (it signs the session cookies)." >&2 ;; esac
fi

for key in molior-password aptly-password; do
    case " $EXISTING$CHANGED " in *" $key "*) ;; *) echo "Warning: $key is not set, the pods will not start without it." >&2 ;; esac
done

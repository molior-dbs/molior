#!/bin/sh
# Install the Debian docker-registry package and put nginx in front of it.
# Run on the target host as root, e.g. from the dev machine:
#   make install-registry IP=<node-ip>
# Registry: 127.0.0.1:5001 with http.prefix /registry, storage under $REGISTRY_DIR.
# nginx: https://<host>/registry/ (location added to the 443 server of install-nginx, no auth).
# Run install-nginx first.
set -eu

REGISTRY_DIR=${REGISTRY_DIR:-/data/registry}

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker-registry nginx

# new directory only, existing data under /data is not touched
mkdir -p "$REGISTRY_DIR"
chown docker-registry:docker-registry "$REGISTRY_DIR"

cat > /etc/docker/registry/config.yml <<CONF
version: 0.1
log:
  fields:
    service: registry
storage:
  filesystem:
    rootdirectory: $REGISTRY_DIR
  delete:
    enabled: true
  cache:
    blobdescriptor: inmemory
http:
  addr: 127.0.0.1:5001
  prefix: /registry
  headers:
    X-Content-Type-Options: [nosniff]
health:
  storagedriver:
    enabled: true
    interval: 10s
    threshold: 3
CONF
systemctl enable docker-registry
systemctl restart docker-registry

grep -q locations.d /etc/nginx/conf.d/molior.conf 2>/dev/null || { echo "Run make install-nginx first (no /etc/nginx/conf.d/molior.conf with locations.d)"; exit 1; }
rm -f /etc/nginx/conf.d/registry.conf
mkdir -p /etc/nginx/locations.d
cat > /etc/nginx/locations.d/registry.conf <<'CONF'
location /registry/ {
    # no URI part in proxy_pass: the /registry prefix is passed on, the registry serves it (http.prefix)
    proxy_pass http://127.0.0.1:5001;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 900;
}
CONF
nginx -t
systemctl reload nginx || systemctl restart nginx

# wait for the registry (it may need a moment after the restart), fail if it does not answer
i=0
until curl -fsSk -o /dev/null https://127.0.0.1/registry/v2/; do
    i=$((i + 1))
    [ $i -ge 15 ] && { echo "registry did not answer at https://127.0.0.1/registry/v2/"; exit 1; }
    sleep 1
done
echo "registry ready at https://<host>/registry/, data in $REGISTRY_DIR"

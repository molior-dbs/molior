#!/bin/sh
# Install the Debian docker-registry package and put nginx in front of it.
# Run on the target host as root, e.g. from the dev machine:
#   make install-registry IP=<node-ip>
# Registry: 127.0.0.1:5001, storage under $REGISTRY_DIR.
# nginx: a server block on 443 for the name $MOLIOR_REGISTRY, serving the registry at the root of that name
# (docker always uses https://<name>/v2/, it cannot use a path prefix). Requests for any other name or the IP
# still go to molior (default_server from install-nginx).
# Reads (GET, HEAD) are open. Writes (push, delete) and the /v2/ ping need a login (basic auth).
# Run install-nginx first. Its certificate must cover $MOLIOR_REGISTRY.
#
# The password for the push user is read from the first line of stdin, so it is not in argv, the environment
# or the make output. Example (from the dev machine, after make rsync):
#   read -rs PW; printf '%s\n' "$PW" | ssh <host> 'cd ~/molior && make install-registry MOLIOR_REGISTRY=<name>'
# It is only needed the first time. Without it an existing htpasswd file is kept (see also passwd-registry).
#
#   MOLIOR_REGISTRY  name clients use, required, no default (it must resolve on the clients)
#   REGISTRY_DIR   data directory                      (default /data/registry)
#   REGISTRY_USER  user that may push                  (default molior)
#   CERT           certificate to check                (default /etc/nginx/ssl/molior.crt)
#   CERT_NAME      name of the ssl snippet             (default molior)
set -eu

MOLIOR_REGISTRY=${MOLIOR_REGISTRY:-}
REGISTRY_DIR=${REGISTRY_DIR:-/data/registry}
REGISTRY_USER=${REGISTRY_USER:-molior}
CERT=${CERT:-/etc/nginx/ssl/molior.crt}
CERT_NAME=${CERT_NAME:-molior}
HTPASSWD=/etc/nginx/registry.htpasswd

case "$MOLIOR_REGISTRY" in
    ""|*[!A-Za-z0-9.-]*) echo "MOLIOR_REGISTRY is required and may only contain letters, digits, dots and dashes (got '$MOLIOR_REGISTRY')"; exit 1 ;;
esac

password=
if [ ! -t 0 ]; then IFS= read -r password || true; fi
if [ -z "$password" ] && [ ! -s "$HTPASSWD" ]; then
    echo "no password on stdin and no $HTPASSWD: pipe the push password in (see the header of this script)"
    exit 1
fi

[ -r "$CERT" ] || { echo "$CERT not found, run make install-nginx first"; exit 1; }
openssl x509 -in "$CERT" -noout -checkhost "$MOLIOR_REGISTRY" | grep -q "does match" ||
    { echo "$CERT does not cover $MOLIOR_REGISTRY: run make install-nginx MOLIOR_REGISTRY=$MOLIOR_REGISTRY FORCE=1"; exit 1; }
grep -q default_server /etc/nginx/conf.d/molior.conf 2>/dev/null ||
    { echo "Run make install-nginx first (no default_server in /etc/nginx/conf.d/molior.conf)"; exit 1; }

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker-registry nginx openssl

# new directory only, existing data under /data is not touched
mkdir -p "$REGISTRY_DIR"
chown docker-registry:docker-registry "$REGISTRY_DIR"

cat > /etc/docker/registry/config.yml <<CONF
version: 0.1
log:
  fields:
    service: registry
storage:
  filesystem:
    rootdirectory: $REGISTRY_DIR
  delete:
    enabled: true
  cache:
    blobdescriptor: inmemory
http:
  addr: 127.0.0.1:5001
  headers:
    X-Content-Type-Options: [nosniff]
health:
  storagedriver:
    enabled: true
    interval: 10s
    threshold: 3
CONF
systemctl enable docker-registry
systemctl restart docker-registry


if [ -n "$password" ]; then
    umask 077
    printf '%s:%s\n' "$REGISTRY_USER" "$(printf '%s' "$password" | openssl passwd -apr1 -stdin)" > "$HTPASSWD"
    umask 022
fi
chown root:www-data "$HTPASSWD"
chmod 640 "$HTPASSWD"

cat > /etc/nginx/snippets/molior-registry-proxy.conf <<'CONF'
proxy_pass http://127.0.0.1:5001;
proxy_http_version 1.1;
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_request_buffering off;
proxy_buffering off;
proxy_read_timeout 900;
CONF

# removed: the earlier /registry/ mapping (docker cannot use a path prefix)
rm -f /etc/nginx/locations.d/registry.conf

cat > /etc/nginx/conf.d/registry.conf <<'CONF'
server {
    listen 443 ssl;
    server_name @MOLIOR_REGISTRY@;
    include snippets/@CERT_NAME@-ssl.conf;

    client_max_body_size 0;

    # the ping needs a login, so that docker sends credentials for the push (a 200 here makes it push anonymously)
    location = /v2/ {
        auth_basic "molior registry";
        auth_basic_user_file /etc/nginx/registry.htpasswd;
        include snippets/molior-registry-proxy.conf;
    }

    # reads are open, everything else needs a login
    location /v2/ {
        limit_except GET HEAD {
            auth_basic "molior registry";
            auth_basic_user_file /etc/nginx/registry.htpasswd;
        }
        include snippets/molior-registry-proxy.conf;
    }
}
CONF
sed -i -e "s|@MOLIOR_REGISTRY@|$MOLIOR_REGISTRY|g" -e "s|@CERT_NAME@|$CERT_NAME|g" /etc/nginx/conf.d/registry.conf
nginx -t
systemctl reload nginx || systemctl restart nginx

# wait for the registry (it may need a moment after the restart), fail if it does not answer.
# --resolve and --cacert make this check the name and the certificate too.
URL=https://$MOLIOR_REGISTRY/v2/_catalog
i=0
until curl -fsS -o /dev/null --resolve "$MOLIOR_REGISTRY:443:127.0.0.1" --cacert "$CERT" "$URL"; do
    i=$((i + 1))
    [ $i -ge 15 ] && { echo "registry did not answer at $URL"; exit 1; }
    sleep 1
done
echo "registry ready at https://$MOLIOR_REGISTRY/, data in $REGISTRY_DIR"

#!/bin/sh
# Install the Debian nginx package and create a self-signed certificate.
# Run on the target host as root: make install-nginx
#
# Variables (all optional):
#   CERT_DIR   where key and certificate go          (default /etc/nginx/ssl)
#   CERT_NAME  file name prefix                      (default molior)
#   CERT_CN    certificate common name               (default: host FQDN)
#   CERT_SAN   subjectAltName list                   (default: DNS:<CN>,DNS:localhost,IP:127.0.0.1,IP:<primary ip>)
#   CERT_DAYS  validity in days                      (default 3650)
#   FORCE=1    regenerate an existing certificate
#   MOLIOR_UPSTREAM  proxy target for https :443     (default http://127.0.0.1:30080)
#   REGISTRY_HOST    registry name (see install-registry): added to the certificate names, and an existing
#                    certificate that does not cover it is an error (FORCE=1 replaces it)
set -eu

CERT_DIR=${CERT_DIR:-/etc/nginx/ssl}
CERT_NAME=${CERT_NAME:-molior}
CERT_DAYS=${CERT_DAYS:-3650}
CERT_CN=${CERT_CN:-$(hostname -f 2>/dev/null || hostname)}

if [ -z "${CERT_SAN:-}" ]; then
    CERT_SAN="DNS:$CERT_CN,DNS:localhost,IP:127.0.0.1"
    primary=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}' | head -1)
    [ -n "$primary" ] && CERT_SAN="$CERT_SAN,IP:$primary"
    [ -n "${REGISTRY_HOST:-}" ] && CERT_SAN="$CERT_SAN,DNS:$REGISTRY_HOST"
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y nginx openssl

mkdir -p "$CERT_DIR"
chmod 755 "$CERT_DIR"

if [ -e "$CERT_DIR/$CERT_NAME.crt" ] && [ -e "$CERT_DIR/$CERT_NAME.key" ] && [ "${FORCE:-}" != 1 ]; then
    if [ -n "${REGISTRY_HOST:-}" ] && ! openssl x509 -in "$CERT_DIR/$CERT_NAME.crt" -noout -checkhost "$REGISTRY_HOST" | grep -q "does match"; then
        echo "Certificate $CERT_DIR/$CERT_NAME.crt does not cover $REGISTRY_HOST, run with FORCE=1 to replace it"
        exit 1
    fi
    echo "Certificate $CERT_DIR/$CERT_NAME.crt exists, keeping it (FORCE=1 to regenerate)"
else
    echo "Creating self-signed certificate CN=$CERT_CN SAN=$CERT_SAN"
    openssl req -x509 -newkey rsa:4096 -sha256 -nodes -days "$CERT_DAYS" \
        -subj "/CN=$CERT_CN" -addext "subjectAltName=$CERT_SAN" \
        -keyout "$CERT_DIR/$CERT_NAME.key" -out "$CERT_DIR/$CERT_NAME.crt"
    chmod 600 "$CERT_DIR/$CERT_NAME.key"
    chmod 644 "$CERT_DIR/$CERT_NAME.crt"
fi

# snippet to include from a server block: include snippets/molior-ssl.conf;
mkdir -p /etc/nginx/snippets
cat > "/etc/nginx/snippets/$CERT_NAME-ssl.conf" <<CONF
ssl_certificate     $CERT_DIR/$CERT_NAME.crt;
ssl_certificate_key $CERT_DIR/$CERT_NAME.key;
ssl_protocols       TLSv1.2 TLSv1.3;
CONF

mkdir -p /etc/nginx/locations.d

# HTTPS front end for molior: 443 -> web NodePort (molior serves plain HTTP on 9999 behind it)
MOLIOR_UPSTREAM=${MOLIOR_UPSTREAM:-http://127.0.0.1:30080}
cat > /etc/nginx/conf.d/molior.conf <<CONF
map \$http_upgrade \$connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl default_server;
    server_name _;
    include snippets/$CERT_NAME-ssl.conf;

    client_max_body_size 0;

    # extra locations for this server
    include /etc/nginx/locations.d/*.conf;

    location / {
        proxy_pass $MOLIOR_UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}
CONF

nginx -t
systemctl enable nginx
systemctl reload nginx || systemctl restart nginx

openssl x509 -in "$CERT_DIR/$CERT_NAME.crt" -noout -subject -enddate -ext subjectAltName
echo "nginx installed, certificate in $CERT_DIR/$CERT_NAME.crt, snippet /etc/nginx/snippets/$CERT_NAME-ssl.conf"
